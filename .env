# --- SERVER SIDE CONFIGURATION (Express / Node) ---
PORT=3000
GROQ_API_KEY=your_groq_sdk_api_key_here

# --- CLIENT & SERVER SHARED (Supabase) ---
# Vite requires 'VITE_' prefix to expose variables to the frontend browser
VITE_SUPABASE_URL=https://supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anonymous_public_key

# --- PAYMENT CONFIGURATION (Paddle) ---
# If used in frontend, keep 'VITE_' prefix. For backend-only, remove it.
VITE_PADDLE_CLIENT_TOKEN=your_paddle_client_side_token_here
PADDLE_API_KEY=your_paddle_backend_api_key_here
VITE_PADDLE_PRICE_ID=paddle_price_id
